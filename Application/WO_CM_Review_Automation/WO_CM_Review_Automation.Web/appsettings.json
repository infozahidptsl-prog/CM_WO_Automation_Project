{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReportBranding": {
    "OrganizationName": "WO CM Review Automation",
    "OrganizationDepartment": "Enterprise Change Management",
    "Footer": "Generated by WO_CM_Review_Automation"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=WO_CM_Review_Automation;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "ImportEngine": {
    "HeaderConfidenceThreshold": 0.8,
    "MaxHeaderScanRows": 20,
    "MaxUploadSizeBytes": 104857600,
    "Mappings": [
      { "CanonicalName": "WO ID", "Classification": "Required", "Aliases": [ "woid", "wo id", "workorder", "ticket", "ticketid", "wo" ] },
      { "CanonicalName": "Status", "Classification": "Required", "Aliases": [ "status", "state", "wostatus", "stat" ] },
      { "CanonicalName": "Subject", "Classification": "Optional", "Aliases": [ "subject" ] },
      { "CanonicalName": "WO Type", "Classification": "Optional", "Aliases": [ "wotype", "wo type" ] },
      { "CanonicalName": "Change Type", "Classification": "Optional", "Aliases": [ "changetype", "change type" ] },
      { "CanonicalName": "Service Name", "Classification": "Required", "Aliases": [ "servicename", "service name", "application", "applicationname", "service", "requestedservice" ] },
      { "CanonicalName": "Domain", "Classification": "Required", "Aliases": [ "domain", "networkdomain" ] },
      { "CanonicalName": "NE Type", "Classification": "Optional", "Aliases": [ "netype", "ne type" ] },
      { "CanonicalName": "NE Count", "Classification": "Optional", "Aliases": [ "necount", "ne count" ] },
      { "CanonicalName": "Vendor", "Classification": "Required", "Aliases": [ "vendor", "vendors", "vendorname", "supplier", "suppliername", "contractor", "subcontractor" ] },
      { "CanonicalName": "Issuer", "Classification": "Required", "Aliases": [ "issuer", "issuername", "creator", "requestedby" ] },
      { "CanonicalName": "QA/KPI Checked By", "Classification": "Optional", "Aliases": [ "qakpicheckedby", "qa/kpi checked by", "kpi checked by", "qa checked by" ] },
      { "CanonicalName": "Assignee", "Classification": "Optional", "Aliases": [ "assignee", "assignee name" ] },
      { "CanonicalName": "SLA", "Classification": "Optional", "Aliases": [ "sla", "s.l.a.", "s.l.a", "service level agreement" ] },
      { "CanonicalName": "Issue Date/Time", "Classification": "Optional", "Aliases": [ "issuedatetime", "issue date/time", "issue date", "issue date / time" ] },
      { "CanonicalName": "Proposed Date/Time", "Classification": "Optional", "Aliases": [ "proposeddatetime", "proposed date/time", "proposed", "proposed start", "proposed date", "proposed time", "proposed start date", "proposed start time" ] },
      { "CanonicalName": "Execution Start", "Classification": "Optional", "Aliases": [ "executionstart", "execution start", "execution start date", "execution start date/time" ] },
      { "CanonicalName": "Execution End", "Classification": "Optional", "Aliases": [ "executionend", "execution end", "execution end date/time", "execution end date", "execution end time", "end date/time", "end date", "end time", "execution completion" ] },
      { "CanonicalName": "Issuer Office", "Classification": "Optional", "Aliases": [ "issueroffice", "department", "office" ] },
      { "CanonicalName": "LM Approver", "Classification": "Optional", "Aliases": [ "lmapprover", "linemanager", "manager", "approver" ] },
      { "CanonicalName": "Approval Date", "Classification": "Optional", "Aliases": [ "approvaldate", "approval date", "approveddate", "dateapproved", "lastupdatedtime" ] }
    ]
  }
}
