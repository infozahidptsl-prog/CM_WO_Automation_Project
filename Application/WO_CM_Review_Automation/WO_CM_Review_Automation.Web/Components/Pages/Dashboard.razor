    private async Task CopyWoAsync(string woNumber)
    {
        if (string.IsNullOrWhiteSpace(woNumber)) return;
        try
        {
            var copied = await JSRuntime.InvokeAsync<bool>("copyTextToClipboard", woNumber);
            if (copied)
            {
                _copiedWoId = woNumber;
                Snackbar.Add($"WO #{woNumber} copied to clipboard", Severity.Success, cfg => cfg.VisibleStateDuration = 1600);
                StateHasChanged();
                await Task.Delay(1600);
                if (_copiedWoId == woNumber)
                {
                    _copiedWoId = null;
                    StateHasChanged();
                }
            }
        }
        catch
        {
            Snackbar.Add($"WO #{woNumber}", Severity.Info);
        }
    }

