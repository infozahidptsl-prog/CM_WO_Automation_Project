    private static (string AppDisplay, bool IsMapped) ResolveApplicationName(
        string? rawService,
        List<ApplicationMapping> appMappings,
        List<FunctionalUnitMapping> fuMappings)
    {
        if (string.IsNullOrWhiteSpace(rawService))
            return ("-", false);

        var delimiters = new[] { ',', ';', '|', '\n', '\r' };
        var tokens = rawService.Split(delimiters, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => Regex.Replace(s.Trim(), @"\s+", " "))
            .ToList();

        foreach (var token in tokens)
        {
            var exactMap = appMappings.FirstOrDefault(m => m.AliasName.Equals(token, StringComparison.OrdinalIgnoreCase));
            if (exactMap != null)
            {
                var norm = exactMap.NormalizedName.Equals("Techvan", StringComparison.OrdinalIgnoreCase) ? "TechVan" : exactMap.NormalizedName;
                return (norm, true);
            }
        }

        foreach (var fu in fuMappings)
        {
            if (rawService.Contains(fu.SourceValue, StringComparison.OrdinalIgnoreCase))
            {
                var fuName = fu.FunctionalUnitName;
                if (fuName.Contains("Sales Force App", StringComparison.OrdinalIgnoreCase))
                    return ("Sales Force App", true);
                if (fuName.Equals("Techvan", StringComparison.OrdinalIgnoreCase))
                    return ("TechVan", true);
                return (fuName, true);
            }
        }

        return (tokens.FirstOrDefault() ?? rawService.Trim(), false);
    }

    private static string NormalizeChangeType(string? rawType)
    {
        if (string.IsNullOrWhiteSpace(rawType)) return "Normal";
        if (rawType.Contains("Emergency", StringComparison.OrdinalIgnoreCase)) return "Emergency";
        if (rawType.Contains("Standard", StringComparison.OrdinalIgnoreCase)) return "Standard";
        return "Normal";
    }

    private static string ResolveTargetCategory(
        string appDisplay,
        string? rawChangeType,
        string displayType,
        string? subject,
        List<ChangeCategoryMapping> catMappings)
    {
        if (!string.IsNullOrWhiteSpace(rawChangeType))
        {
            var mapped = catMappings.FirstOrDefault(m =>
                m.ApplicationName.Equals(appDisplay, StringComparison.OrdinalIgnoreCase) &&
                m.ChangeType.Equals(rawChangeType.Trim(), StringComparison.OrdinalIgnoreCase));

            if (mapped != null && !string.IsNullOrWhiteSpace(mapped.CategoryName))
            {
                return mapped.CategoryName;
            }
        }

        if (!string.IsNullOrWhiteSpace(subject))
        {
            if (subject.Contains("deploy", StringComparison.OrdinalIgnoreCase) || subject.Contains("upgradation", StringComparison.OrdinalIgnoreCase))
                return "Deploy new application / Modules";
            if (subject.Contains("fix", StringComparison.OrdinalIgnoreCase) || subject.Contains("issue", StringComparison.OrdinalIgnoreCase))
                return "Bug Fixing";
            if (subject.Contains("api", StringComparison.OrdinalIgnoreCase) || subject.Contains("feature", StringComparison.OrdinalIgnoreCase) || subject.Contains("enable", StringComparison.OrdinalIgnoreCase))
                return "Add new features/module in existing application";
            if (subject.Contains("server", StringComparison.OrdinalIgnoreCase) || subject.Contains("install", StringComparison.OrdinalIgnoreCase))
                return "Software install/remove/configure in server";
        }

        if (displayType.Equals("Standard", StringComparison.OrdinalIgnoreCase))
            return "Standard Change";
        if (displayType.Equals("Emergency", StringComparison.OrdinalIgnoreCase))
            return "Bug Fixing";

        return "Implementation of Change Request";
    }

    private static string ShortenCategoryName(string cat)
    {
        if (cat.Contains("Add new features", StringComparison.OrdinalIgnoreCase))
            return "Add new features/module in existing app";
        if (cat.Contains("Software install", StringComparison.OrdinalIgnoreCase))
            return "Software install/configure in server";
        if (cat.Contains("Bug Fixing", StringComparison.OrdinalIgnoreCase) || cat.Contains("Data reconciliation", StringComparison.OrdinalIgnoreCase))
            return "Bug Fixing / Data Reconciliation";
        return cat;
    }

    private static bool TryParseWoDate(string? raw, out DateTime parsed)
    {
        parsed = default;
        if (string.IsNullOrWhiteSpace(raw)) return false;

        var clean = raw.Trim();
        var formats = new[]
        {
            "yyyy-MM-dd HH:mm:ss", "yyyy-MM-dd HH:mm", "yyyy-MM-dd",
            "dd-MM-yyyy HH:mm:ss", "dd-MM-yyyy HH:mm", "dd-MM-yyyy",
            "dd/MM/yyyy HH:mm:ss", "dd/MM/yyyy HH:mm", "dd/MM/yyyy",
            "MM/dd/yyyy HH:mm:ss", "MM/dd/yyyy HH:mm", "MM/dd/yyyy",
            "dd MMM yyyy, HH:mm", "dd MMM yyyy HH:mm", "dd MMM yyyy"
        };

        if (DateTime.TryParseExact(clean, formats, CultureInfo.InvariantCulture, DateTimeStyles.AllowWhiteSpaces, out parsed))
            return true;

        return DateTime.TryParse(clean, CultureInfo.InvariantCulture, DateTimeStyles.AllowWhiteSpaces, out parsed);
    }

    private static (string Formatted, DateTime? Parsed) FormatExecutedDate(WorkOrder wo)
    {
        var candidates = new[] { wo.ExecutionEnd, wo.ApprovalDate, wo.ExecutionStart, wo.IssueDateTime };
        foreach (var c in candidates)
        {
            if (TryParseWoDate(c, out var dt))
            {
                return (dt.ToString("dd MMM yyyy", CultureInfo.InvariantCulture), dt);
            }
        }
        return ("-", null);
    }

    private static (int Month, int Year) DetermineUploadMonthYear(UploadHistory upload)
    {
        if (!string.IsNullOrWhiteSpace(upload.FileName))
        {
            var monthMap = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
            {
                ["january"] = 1, ["jan"] = 1,
                ["february"] = 2, ["feb"] = 2,
                ["march"] = 3, ["mar"] = 3,
                ["april"] = 4, ["apr"] = 4,
                ["may"] = 5,
                ["june"] = 6, ["jun"] = 6,
                ["july"] = 7, ["jul"] = 7,
                ["august"] = 8, ["aug"] = 8,
                ["september"] = 9, ["sept"] = 9, ["sep"] = 9,
                ["october"] = 10, ["oct"] = 10,
                ["november"] = 11, ["nov"] = 11,
                ["december"] = 12, ["dec"] = 12
            };

            var m = Regex.Match(upload.FileName, @"(january|february|march|april|may|june|july|august|september|sept|october|november|december|jan|feb|mar|apr|jun|jul|aug|sep|oct|nov|dec)['\-\s_]*(\d{4})", RegexOptions.IgnoreCase);
            if (m.Success && monthMap.TryGetValue(m.Groups[1].Value, out int fMonth) && int.TryParse(m.Groups[2].Value, out int fYear))
            {
                return (fMonth, fYear);
            }
        }
        return (upload.UploadDate.Month, upload.UploadDate.Year);
    }
