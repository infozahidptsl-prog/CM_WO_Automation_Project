    private async Task ExportCsvAsync()
    {
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("WO,Summary,Application,RawServiceName,WOType,ChangeType,Status,Domain,NEType,NECount,Vendor,Issuer,IssuerOffice,LMApprover,QAKPICheckedBy,Assignee,TeamLead,SLA,IssueDateTime,ProposedDateTime,ExecutionStart,ExecutionEnd,ApprovalDate");

            foreach (var item in FilteredItems)
            {
                sb.AppendLine($"\"{EscapeCsv(item.DisplayWoId)}\",\"{EscapeCsv(item.Summary)}\",\"{EscapeCsv(item.ApplicationDisplay)}\",\"{EscapeCsv(item.RawServiceName)}\",\"{EscapeCsv(item.WoType)}\",\"{EscapeCsv(item.RawChangeType)}\",\"{EscapeCsv(item.DisplayStatus)}\",\"{EscapeCsv(item.Domain)}\",\"{EscapeCsv(item.NeType)}\",\"{EscapeCsv(item.NeCount?.ToString())}\",\"{EscapeCsv(item.Vendor)}\",\"{EscapeCsv(item.Issuer)}\",\"{EscapeCsv(item.IssuerOffice)}\",\"{EscapeCsv(item.LmApprover)}\",\"{EscapeCsv(item.QaKpiCheckedBy)}\",\"{EscapeCsv(item.Assignee)}\",\"{EscapeCsv(item.TeamLeaderName)}\",\"{EscapeCsv(item.Sla)}\",\"{EscapeCsv(item.DisplayIssueDateTime)}\",\"{EscapeCsv(item.DisplayProposedDateTime)}\",\"{EscapeCsv(item.DisplayExecutionStart)}\",\"{EscapeCsv(item.DisplayExecutionEnd)}\",\"{EscapeCsv(item.DisplayApprovalDate)}\"");
            }

            var bytes = Encoding.UTF8.GetBytes(sb.ToString());
            using var streamRef = new DotNetStreamReference(new System.IO.MemoryStream(bytes));
            var safePeriod = _monthYearLabel.Replace(" ", "_");
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", $"WO_Archive_{safePeriod}.csv", streamRef);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting CSV: {ex.Message}", Severity.Error);
        }
    }

    private static string EscapeCsv(string? val)
    {
        if (string.IsNullOrEmpty(val)) return string.Empty;
        return val.Replace("\"", "\"\"");
    }
