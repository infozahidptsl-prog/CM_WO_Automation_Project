@page "/report"
@page "/report/{SelectedUploadId:guid}"
@using WO_CM_Review_Automation.Application.Reports
@using WO_CM_Review_Automation.Domain.Entities
@using WO_CM_Review_Automation.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using System.IO
@using WO_CM_Review_Automation.Web.Components.Shared
@inject ApplicationDbContext DbContext
@inject IChangeManagementReportService ReportService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<PageTitle>Monthly Report - WO CM Review</PageTitle>

<!-- Toolbar for Screen Only -->
<div class="repview-header-wrap print-hide">
    <button type="button" class="repview-back-link" @onclick='() => NavigationManager.NavigateTo("/reports")'>
        <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Style="font-size: 14px;" />
        <span>WO Count</span>
    </button>

    <div class="repview-top-bar">
        <div class="repview-title-group">
            <div class="d-flex align-center" style="gap: 8px; position: relative;">
                <div class="ent-action-menu-wrap" @onclick:stopPropagation="true">
                    <button type="button"
                            class="repview-title-switcher"
                            disabled="@_isEditing"
                            @onclick="@(() => { _showSwitcherMenu = !_showSwitcherMenu; _showExportMenu = false; _showMoreMenu = false; })">
                        <span>@(_result?.MonthYear ?? "Select report") summary</span>
                        <MudIcon Icon="@Icons.Material.Outlined.KeyboardArrowDown" Style="font-size: 22px; color: #64748b; margin-top: 2px;" />
                    </button>

                    @if (_showSwitcherMenu && !_isEditing)
                    {
                        <div class="ent-action-menu-backdrop" @onclick="CloseAllMenus"></div>
                        <div class="ent-action-menu-dropdown left" style="min-width: 280px; max-height: 320px; overflow-y: auto;">
                            @foreach (var upload in _recentUploads)
                            {
                                <button type="button"
                                        class="ent-action-menu-item"
                                        @onclick="@(async () => { CloseAllMenus(); await OnUploadSelected(upload.Id); })">
                                    <div class="d-flex flex-column text-left">
                                        <span style="font-weight: 600; font-size: 0.78rem; color: var(--color-text-primary);">@upload.FileName</span>
                                        <span style="font-size: 0.69rem; color: var(--color-text-muted);">@upload.UploadDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm") · @(upload.RawWorkOrders > 0 ? upload.RawWorkOrders : upload.TotalRows) rows</span>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (_selectedUpload != null)
            {
                <div class="repview-subtitle">
                    @_selectedUpload.FileName · @(_selectedUpload.RawWorkOrders > 0 ? _selectedUpload.RawWorkOrders : _selectedUpload.TotalRows) rows · uploaded @_selectedUpload.UploadDate.ToLocalTime().ToString("MMM dd, HH:mm")
                </div>
            }
        </div>

        <div class="repview-actions">
            @if (_result != null)
            {
                @if (_isEditing)
                {
                    <button type="button" class="dash-btn-outline" @onclick="CancelEditing">
                        <span>Cancel</span>
                    </button>
                    <button type="button" class="dash-btn-primary" style="background: #10b981; border-color: #10b981;" @onclick="SaveChanges">
                        <MudIcon Icon="@Icons.Material.Outlined.Check" Style="font-size: 16px;" />
                        <span>Save changes</span>
                    </button>
                }
                else
                {
                    <button type="button" class="dash-btn-outline" @onclick="EnableEditing">
                        <MudIcon Icon="@Icons.Material.Outlined.Edit" Style="font-size: 15px;" />
                        <span>Edit</span>
                    </button>
                }

                <!-- Export Menu -->
                <div class="ent-action-menu-wrap" @onclick:stopPropagation="true">
                    <button type="button"
                            class="dash-btn-primary"
                            disabled="@(_result == null || _isEditing)"
                            @onclick="@(() => { _showExportMenu = !_showExportMenu; _showMoreMenu = false; _showSwitcherMenu = false; })">
                        <MudIcon Icon="@Icons.Material.Outlined.FileDownload" Style="font-size: 16px;" />
                        <span>Export</span>
                        <MudIcon Icon="@Icons.Material.Outlined.KeyboardArrowDown" Style="font-size: 16px; margin-left: 2px;" />
                    </button>

                    @if (_showExportMenu && !_isEditing)
                    {
                        <div class="ent-action-menu-backdrop" @onclick="CloseAllMenus"></div>
                        <div class="ent-action-menu-dropdown" style="min-width: 225px;">
                            <button type="button"
                                    class="ent-action-menu-item justify-space-between"
                                    disabled="@_isExportingExcel"
                                    @onclick="@(async () => { CloseAllMenus(); if (activeTabIndex == 2) await ExportFilteredExcel(); else await ExportExcel(); })">
                                <span class="d-flex align-center" style="gap: 9px;">
                                    <MudIcon Icon="@Icons.Material.Outlined.Description" Style="font-size: 16px; color: #64748b;" />
                                    <span>Excel workbook</span>
                                </span>
                                <span class="repview-menu-hint">.xlsx</span>
                            </button>

                            <button type="button"
                                    class="ent-action-menu-item justify-space-between"
                                    @onclick="@(async () => { CloseAllMenus(); await PrintReport(); })">
                                <span class="d-flex align-center" style="gap: 9px;">
                                    <MudIcon Icon="@Icons.Material.Outlined.Print" Style="font-size: 16px; color: #64748b;" />
                                    <span>Print or save PDF</span>
                                </span>
                                <span class="repview-menu-hint">⌘P</span>
                            </button>

                            <button type="button"
                                    class="ent-action-menu-item justify-space-between"
                                    disabled="@_isExportingImage"
                                    @onclick="@(async () => { CloseAllMenus(); if (activeTabIndex == 2) await ExportFilteredImage(); else await ExportImage(); })">
                                <span class="d-flex align-center" style="gap: 9px;">
                                    <MudIcon Icon="@Icons.Material.Outlined.Image" Style="font-size: 16px; color: #64748b;" />
                                    <span>PNG image</span>
                                </span>
                                <span class="repview-menu-hint">.png</span>
                            </button>

                            <div class="ent-action-menu-divider"></div>

                            <button type="button"
                                    class="ent-action-menu-item"
                                    disabled="@_isCopyingImage"
                                    @onclick="@(async () => { CloseAllMenus(); if (activeTabIndex == 2) await CopyFilteredImage(); else await CopyImage(); })">
                                <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Style="font-size: 16px; color: #64748b;" />
                                <span>Copy as image</span>
                            </button>
                        </div>
                    }
                </div>

                <!-- More Actions (...) Menu -->
                <div class="ent-action-menu-wrap" @onclick:stopPropagation="true">
                    <button type="button"
                            class="repview-more-btn @(_showMoreMenu ? "active" : "")"
                            title="More actions"
                            disabled="@_isEditing"
                            @onclick="@(() => { _showMoreMenu = !_showMoreMenu; _showExportMenu = false; _showSwitcherMenu = false; })">
                        <MudIcon Icon="@Icons.Material.Outlined.MoreHoriz" Style="font-size: 18px;" />
                    </button>

                    @if (_showMoreMenu && !_isEditing)
                    {
                        <div class="ent-action-menu-backdrop" @onclick="CloseAllMenus"></div>
                        <div class="ent-action-menu-dropdown" style="min-width: 195px;">
                            <button type="button"
                                    class="ent-action-menu-item"
                                    @onclick="@(() => { _showTotalRow = !_showTotalRow; CloseAllMenus(); })">
                                <MudIcon Icon="@(_showTotalRow ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)" Style="font-size: 16px; color: #64748b;" />
                                <span>@(_showTotalRow ? "Hide total row" : "Show total row")</span>
                            </button>

                            <button type="button"
                                    class="ent-action-menu-item"
                                    @onclick="@(async () => { CloseAllMenus(); await ResetToAutoGenerated(); })">
                                <MudIcon Icon="@Icons.Material.Outlined.Restore" Style="font-size: 16px; color: #64748b;" />
                                <span>Reset to default</span>
                            </button>

                            <div class="ent-action-menu-divider"></div>

                            <button type="button"
                                    class="ent-action-menu-item danger"
                                    disabled="@(_selectedUploadId == null || _isLoading)"
                                    @onclick="@(async () => { CloseAllMenus(); await DeleteUpload(); })">
                                <MudIcon Icon="@Icons.Material.Outlined.DeleteOutline" Style="font-size: 16px;" />
                                <span>Delete report</span>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (_result == null)
{
    <EnterpriseEmptyState 
        Icon="@Icons.Material.Filled.Article" 
        Title="No Report Selected" 
        Description="Select a month from the dropdown above to view the change management report." />
}
else
{
    <!-- Custom Tab Strip matching design -->
    <div class="repview-tabs-bar print-hide">
        <button type="button" class="repview-tab @(activeTabIndex == 0 ? "active" : "")" @onclick="() => activeTabIndex = 0">
            Monthly summary
        </button>
        <button type="button" class="repview-tab @(activeTabIndex == 1 ? "active" : "")" @onclick="() => activeTabIndex = 1">
            WOs for CM review
        </button>
        <button type="button" class="repview-tab @(activeTabIndex == 2 ? "active" : "")" @onclick="() => activeTabIndex = 2">
            Filtered Excel
        </button>
    </div>

    @if (activeTabIndex == 0 || activeTabIndex == 1)
    {
        <!-- Note & Show Total Row Switch Bar -->
        <div class="repview-sheet-meta print-hide">
            <span class="repview-sheet-note">This is the sheet exactly as it exports.</span>
            <label class="repview-switch-wrap">
                <span class="prep-switch">
                    <input type="checkbox" @bind="_showTotalRow" />
                    <span class="prep-switch-slider"></span>
                </span>
                <span class="repview-switch-label">Show total row</span>
            </label>
        </div>
    }

    <!-- Sheet Card Container (Existing Table Colors, Fonts, and Exports Preserved) -->
    <div class="repview-sheet-card">
        @if (activeTabIndex == 0)
        {
            <div id="report-container" class="ent-print-a4" style="padding: 20px;">
                <div id="monthly-summary-export-wrapper" class="mb-6" style="padding: 2px; background-color: white;">
                    <table id="monthly-summary-table" class="w-100" style="border-collapse: collapse; text-align: center; border: 2px solid black; font-family: Calibri, sans-serif;">
                    <thead>
                        <tr>
                            <th colspan="5" style="background-color: #F4B084; padding: 6px; font-weight: bold; border: 1px solid black; color: black; font-size: 1.1rem;">
                                Change Management Summary @_result.MonthYear
                            </th>
                            @if (_isEditing)
                            {
                                <th style="border: none;"></th>
                            }
                        </tr>
                        <tr>
                            <th style="background-color: #FFE699; padding: 6px; font-weight: bold; border: 1px solid black; text-align: left; color: black; width: 15%;">
                                Total Change :
                            </th>
                            <th colspan="4" style="background-color: #FFE699; padding: 6px; font-weight: bold; border: 1px solid black; text-align: left; color: black;">
                                @if (_isEditing)
                                {
                                    <MudNumericField @bind-Value="_result.TotalRawWorkOrders" Margin="Margin.Dense" HideSpinButtons="true" Variant="Variant.Outlined" />
                                }
                                else
                                {
                                    @_result.TotalRawWorkOrders
                                }
                            </th>
                            @if (_isEditing)
                            {
                                <th style="border: none;"></th>
                            }
                        </tr>
                        <tr style="background-color: #595959; color: white;">
                            <th style="border: 1px solid black; padding: 6px; font-weight: bold; width: 15%;">Division</th>
                            <th style="border: 1px solid black; padding: 6px; font-weight: bold; width: 25%;">Functional Unit</th>
                            <th style="border: 1px solid black; padding: 6px; font-weight: bold; width: 25%;">Team Leader/POC</th>
                            <th style="border: 1px solid black; padding: 6px; font-weight: bold; width: 10%;">Actual Count</th>
                            <th style="border: 1px solid black; padding: 6px; font-weight: bold; width: 25%;">WO No.</th>
                            @if (_isEditing)
                            {
                                <th style="border: none; width: 50px;"></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            bool isFirst = true;
                            int itemCount = _result.Items.Count;
                        }
                        @foreach (var item in _result.Items)
                        {
                            <tr @key="item.GetHashCode()">
                                @if (isFirst)
                                {
                                    <td rowspan="@itemCount" style="border: 1px solid black; border-left: 2px solid black; padding: 6px; vertical-align: middle; background-color: white; color: black; text-align: center;">
                                        Business Support<br/>Service and Operations<br/>Support Service
                                    </td>
                                    isFirst = false;
                                }
                                <td style="border: 1px solid black; padding: 6px; text-align: left; background-color: @(item.RowColor ?? "white"); color: black;">
                                    @if (_isEditing)
                                    {
                                        <MudTextField @bind-Value="item.FunctionalUnit" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                    }
                                    else
                                    {
                                        @item.FunctionalUnit
                                    }
                                </td>
                                <td style="border: 1px solid black; padding: 6px; background-color: @(item.RowColor ?? "white"); color: black;">
                                    @if (_isEditing)
                                    {
                                        <MudTextField @bind-Value="item.TeamLeader" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                    }
                                    else
                                    {
                                        @item.TeamLeader
                                    }
                                </td>
                                <td style="border: 1px solid black; padding: 6px; background-color: @(item.RowColor ?? "white"); color: black;">
                                    @if (_isEditing)
                                    {
                                        <MudNumericField @bind-Value="item.ActualCount" Margin="Margin.Dense" HideSpinButtons="true" Variant="Variant.Outlined" />
                                    }
                                    else
                                    {
                                        @item.ActualCount
                                    }
                                </td>
                                <td style="border: 1px solid black; padding: 6px; background-color: @(item.RowColor ?? "white"); color: black; max-width: 250px; white-space: normal;">
                                    @if (_isEditing)
                                    {
                                        <MudTextField Value="@GetWorkOrdersString(item)" ValueChanged="@((string s) => UpdateWorkOrders(item, s))" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                    }
                                    else
                                    {
                                        @(item.ActualCount == 0 ? "N/A" : string.Join(", ", item.WorkOrderIds))
                                    }
                                </td>
                                @if (_isEditing)
                                {
                                    <td style="border: none; text-align: center; white-space: nowrap; background-color: @(item.RowColor ?? "white");" class="print-hide">
                                        <div class="d-flex align-center gap-2">
                                            <ExcelColorPicker Value="@item.RowColor" ValueChanged="@((string? c) => { item.RowColor = c; StateHasChanged(); })" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => RemoveRow(item)" />
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                        @if (_showTotalRow)
                        {
                            <tr>
                                <td colspan="3" style="border: 1px solid black; padding: 6px; text-align: right; font-weight: bold; background-color: white; color: black;">Total</td>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold; background-color: #E2EFDA; color: black;">@_result.TotalWorkOrders</td>
                                <td style="border: 1px solid black; padding: 6px; background-color: white; color: black;"></td>
                                @if (_isEditing)
                                {
                                    <td style="border: none;"></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                @if (_isEditing)
                {
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="AddRow" Class="mt-2">Add Row</MudButton>
                }

                <!-- Signatures matching attached design -->
                <div class="repview-signatures print-hide-editing">
                    <div class="repview-sig-col">
                        <div class="repview-sig-line"></div>
                        <span class="repview-sig-label">Reviewer signature</span>
                    </div>
                    <div class="repview-sig-col right">
                        <div class="repview-sig-line"></div>
                        <span class="repview-sig-label">Date</span>
                    </div>
                </div>
            </div>
        }
        else if (activeTabIndex == 1)
        {
            <div id="cm-report-container" class="ent-print-a4" style="padding: 20px;">
                <div id="cm-review-export-wrapper" class="mb-6" style="padding: 2px; background-color: white;">
                    <table id="cm-review-table" class="w-100" style="border-collapse: collapse; text-align: center; border: 2px solid black; font-family: Calibri, sans-serif;">
                    <thead>
                        <tr>
                            <th colspan="6" style="background-color: #F4B084; padding: 6px; font-weight: bold; border: 1px solid black; color: black; font-size: 1.1rem;">
                                Change Management Summary @_result.MonthYear
                            </th>
                        </tr>
                        <tr>
                            <th style="background-color: #FFE699; padding: 6px; font-weight: bold; border: 1px solid black; text-align: left; color: black; width: 15%;">
                                Total Change :
                            </th>
                            <th colspan="5" style="background-color: #FFE699; padding: 6px; font-weight: bold; border: 1px solid black; text-align: left; color: black;">
                                @_result.TotalRawWorkOrders
                            </th>
                        </tr>
                        <tr style="background-color: #8EA9DB; color: black;">
                            <th style="border: 1px solid black; padding: 6px; font-weight: bold; width: 15%;">Division</th>
                            <th style="border: 1px solid black; padding: 6px; font-weight: bold; width: 25%;">Functional Unit</th>
                            <th style="border: 1px solid black; padding: 6px; font-weight: bold; width: 25%;">Team Leader/POC</th>
                            <th style="border: 1px solid black; padding: 6px; font-weight: bold; width: 15%;">Implemented Change</th>
                            <th style="border: 1px solid black; padding: 6px; font-weight: bold; width: 15%;">Implemented Change with<br/>backdated CM</th>
                            <th style="border: 1px solid black; padding: 6px; font-weight: bold; width: 5%;">Total</th>
                            @if (_isEditing)
                            {
                                <th style="padding: 6px; font-weight: bold; width: 8%;" class="print-hide">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            bool isFirstCm = true;
                            int itemCountCm = _result.Items.Count;
                        }
                        @foreach (var item in _result.Items)
                        {
                            <tr @key="item.GetHashCode()">
                                @if (isFirstCm)
                                {
                                    <td rowspan="@itemCountCm" style="border: 1px solid black; border-left: 2px solid black; padding: 6px; vertical-align: middle; background-color: white; color: black; text-align: center;">
                                        <div style="display: inline-block;">
                                            Business Support<br/>Service and Operations<br/>Support Service
                                        </div>
                                    </td>
                                    isFirstCm = false;
                                }
                                <td style="border: 1px solid black; padding: 6px; text-align: left; background-color: @(item.RowColor ?? "white"); color: black;">@item.FunctionalUnit</td>
                                <td style="border: 1px solid black; padding: 6px; background-color: @(item.RowColor ?? "white"); color: black;">@item.TeamLeader</td>
                                <td style="border: 1px solid black; padding: 6px; background-color: @(item.RowColor ?? "white"); color: black;">@item.ActualCount</td>
                                <td style="border: 1px solid black; padding: 6px; background-color: @(item.RowColor ?? "white"); color: black;"></td>
                                <td style="border: 1px solid black; padding: 6px; background-color: @(item.RowColor ?? "white"); color: black;">@item.ActualCount</td>
                                @if (_isEditing)
                                {
                                    <td style="border: none; text-align: center; white-space: nowrap; background-color: @(item.RowColor ?? "white");" class="print-hide">
                                        <ExcelColorPicker Value="@item.RowColor" ValueChanged="@((string? c) => { UpdateCMRowColor(item, c); StateHasChanged(); })" />
                                    </td>
                                }
                            </tr>
                        }
                        @if (_showTotalRow)
                        {
                            <tr>
                                <td colspan="3" style="border: 1px solid black; padding: 6px; text-align: right; font-weight: bold; background-color: white; color: black;">Total</td>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold; background-color: #E2EFDA; color: black;">@_result.TotalWorkOrders</td>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold; background-color: white; color: black;"></td>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold; background-color: #E2EFDA; color: black;">@_result.TotalWorkOrders</td>
                                @if (_isEditing)
                                {
                                    <td style="border: none;"></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                </div>

                <!-- Signatures matching Monthly summary -->
                <div class="repview-signatures print-hide-editing">
                    <div class="repview-sig-col">
                        <div class="repview-sig-line"></div>
                        <span class="repview-sig-label">Reviewer signature</span>
                    </div>
                    <div class="repview-sig-col right">
                        <div class="repview-sig-line"></div>
                        <span class="repview-sig-label">Date</span>
                    </div>
                </div>
            </div>
        }
        else if (activeTabIndex == 2)
        {
            <div id="filtered-excel-container" style="@((_isExportingImage || _isCopyingImage) ? "width: fit-content;" : "") padding: 20px;">
                <div id="filtered-table-only" style="@((_isExportingImage || _isCopyingImage) ? "overflow: visible; width: fit-content;" : "overflow-x: auto;") background-color: white; border: 1px solid #d4d4d4;">
                    <table class="w-100 mb-0" style="border-collapse: collapse; text-align: left; font-family: Calibri, sans-serif; white-space: nowrap; font-size: 11pt;">
                        <thead>
                            <tr style="background-color: white; color: black; border-bottom: 2px solid #d4d4d4;">
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">WO</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">Stat</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">Subject</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">WO Type</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">Change Type</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">Service Name</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">Domain</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">NE Type</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">NE Count</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">Vendors</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">Issuer</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">QA / KPI Checked By</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">Assignee</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">SLA</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">Issue Date/Time</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">Proposed</th>
                                <th style="border-right: 1px solid #d4d4d4; padding: 4px 6px; font-weight: bold;">Execution Start</th>
