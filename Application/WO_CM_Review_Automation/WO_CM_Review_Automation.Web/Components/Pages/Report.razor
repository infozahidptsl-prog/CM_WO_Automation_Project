@code {
    [Parameter]
    public Guid? SelectedUploadId { get; set; }

    private List<UploadHistory> _recentUploads = new();
    private Guid? _selectedUploadId;
    private UploadHistory? _selectedUpload;
    private ChangeManagementReportResult? _result;
    private ChangeManagementReportResult? _originalResult;
    private bool _isLoading;
    private bool _isExportingExcel;
    private bool _isExportingImage;
    private bool _isCopyingImage;
    private bool _isEditing;
    private bool _showTotalRow = true;
    private bool _showSwitcherMenu;
    private bool _showExportMenu;
    private bool _showMoreMenu;
    private int activeTabIndex = 0;

    private void CloseAllMenus()
    {
        _showSwitcherMenu = false;
        _showExportMenu = false;
        _showMoreMenu = false;
    }

    protected override async Task OnInitializedAsync()
    {
        _recentUploads = await DbContext.UploadHistories
            .OrderByDescending(x => x.UploadDate)
            .ToListAsync();

        if (!SelectedUploadId.HasValue && _recentUploads.Any())
        {
            await OnUploadSelected(_recentUploads.First().Id);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SelectedUploadId.HasValue && SelectedUploadId.Value != _selectedUploadId)
        {
            await OnUploadSelected(SelectedUploadId.Value);
        }
    }

    private async Task OnUploadSelected(Guid? uploadId)
    {
        _selectedUploadId = uploadId;
        _isEditing = false;
        
        if (uploadId.HasValue)
        {
            _isLoading = true;
            try
            {
                _selectedUpload = _recentUploads.FirstOrDefault(x => x.Id == uploadId);
                _result = await ReportService.GenerateReportAsync(uploadId.Value);
                var jsonOptions = new System.Text.Json.JsonSerializerOptions { ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles };
                _originalResult = System.Text.Json.JsonSerializer.Deserialize<ChangeManagementReportResult>(System.Text.Json.JsonSerializer.Serialize(_result, jsonOptions), jsonOptions);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error loading report: {ex.Message}", Severity.Error);
            }
            finally
            {
                _isLoading = false;
            }
        }
        else
        {
            _result = null;
            _originalResult = null;
            _selectedUpload = null;
        }
    }
    
    private void EnableEditing()
    {
        _isEditing = true;
        // Make a clone in case of cancel
        _originalResult = System.Text.Json.JsonSerializer.Deserialize<ChangeManagementReportResult>(System.Text.Json.JsonSerializer.Serialize(_result));
    }
    
    private void CancelEditing()
    {
        _isEditing = false;
        // Restore from clone
        if (_originalResult != null)
        {
            _result = System.Text.Json.JsonSerializer.Deserialize<ChangeManagementReportResult>(System.Text.Json.JsonSerializer.Serialize(_originalResult));
        }
    }

    private async Task SaveChanges()
    {
        if (_selectedUploadId == null || _result == null) return;
        
        try
        {
            _isLoading = true;
            
            // Recalculate totals
            _result.TotalWorkOrders = _result.Items.Sum(x => x.ActualCount);
            
            await ReportService.SaveFinalizedReportAsync(_selectedUploadId.Value, _result);
            _isEditing = false;
            Snackbar.Add("Report edits saved successfully.", Severity.Success);
            
            _originalResult = System.Text.Json.JsonSerializer.Deserialize<ChangeManagementReportResult>(System.Text.Json.JsonSerializer.Serialize(_result));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving report: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    private async Task ResetToAutoGenerated()
    {
        if (_selectedUploadId == null) return;
        
        var parameters = new DialogParameters
        {
            { "ContentText", "Are you sure you want to discard your saved edits and regenerate the report from the original data?" },
            { "SubmitText", "Reset to Default" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<WO_CM_Review_Automation.Web.Components.Shared.Enterprise.EnterpriseDialog>("Confirm Reset", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                _isLoading = true;
                
                var history = await DbContext.UploadHistories.FindAsync(_selectedUploadId.Value);
                if (history != null)
                {
                    history.FinalizedReportJson = null;
                    await DbContext.SaveChangesAsync();
                }
                
                // Reload
                await OnUploadSelected(_selectedUploadId.Value);
                Snackbar.Add("Report reset successfully.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error resetting report: {ex.Message}", Severity.Error);
            }
            finally
            {
                _isLoading = false;
            }
        }
    }
    private void UpdateCMRowColor(ChangeManagementReportItem item, string? color)
    {
        item.RowColor = color;
        
        // Auto-sync color to Filtered Excel rows
        if (_result != null && _result.FilteredWorkOrders != null && item.WorkOrderIds != null)
        {
            var matchedWOs = _result.FilteredWorkOrders.Where(wo => item.WorkOrderIds.Contains(wo.WoId));
            foreach (var wo in matchedWOs)
            {
                wo.RowColor = color;
            }
        }
    }
    
    private void UpdateWorkOrders(ChangeManagementReportItem item, string commaSeparated)
    {
        item.WorkOrderIds = string.IsNullOrWhiteSpace(commaSeparated) 
            ? new List<string>() 
            : commaSeparated.Split(',').Select(x => x.Trim()).Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
            
        item.ActualCount = item.WorkOrderIds.Count;
        if (_result != null)
        {
            _result.TotalWorkOrders = _result.Items.Sum(x => x.ActualCount);
        }
    }
    
    private string GetWorkOrdersString(ChangeManagementReportItem item)
    {
        return string.Join(", ", item.WorkOrderIds);
    }
    
    private async Task RemoveFilteredRow(WO_CM_Review_Automation.Domain.Entities.WorkOrder item)
    {
        if (_result != null)
        {
            bool? result = await DialogService.ShowMessageBoxAsync(
                "Confirm Delete",
                "Are you sure you want to delete this filtered work order?",
                yesText: "Delete", cancelText: "Cancel");
                
            if (result == true)
            {
                _result.FilteredWorkOrders.Remove(item);
                
                if (_result.Items != null)
                {
                    foreach (var summaryItem in _result.Items)
                    {
                        if (summaryItem.WorkOrderIds != null && summaryItem.WorkOrderIds.Contains(item.WoId))
                        {
                            summaryItem.WorkOrderIds.Remove(item.WoId);
                            summaryItem.ActualCount = summaryItem.WorkOrderIds.Count;
                        }
                    }
                    _result.TotalWorkOrders = _result.Items.Sum(x => x.ActualCount);
                }
                
                StateHasChanged();
            }
        }
    }
    
    private async Task RemoveRow(ChangeManagementReportItem item)
    {
        if (_result != null)
        {
            bool? result = await DialogService.ShowMessageBoxAsync(
                "Confirm Delete",
                "Are you sure you want to delete this row?",
                yesText: "Delete", cancelText: "Cancel");
                
            if (result == true)
            {
                _result.Items.Remove(item);
                _result.TotalWorkOrders = _result.Items.Sum(x => x.ActualCount);
                StateHasChanged();
            }
        }
    }
    
    private void AddRow()
    {
        if (_result != null)
        {
            _result.Items.Add(new ChangeManagementReportItem
            {
                Division = "Business Support\nService and Operations\nSupport Service",
                FunctionalUnit = "New Unit",
                TeamLeader = "New Leader",
                ActualCount = 0,
                WorkOrderIds = new List<string>()
            });
        }
    }

    private async Task PrintReport()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async Task ExportExcel()
    {
        if (_selectedUploadId == null) return;
        
        try
        {
            _isExportingExcel = true;
            byte[] fileContent;
            string fileName;
            
            if (activeTabIndex == 0)
            {
                fileContent = await ReportService.ExportExcelAsync(_selectedUploadId.Value);
                fileName = $"Change_Management_Summary_{_result?.MonthYear}.xlsx";
            }
            else
            {
                fileContent = await ReportService.ExportCMReviewExcelAsync(_selectedUploadId.Value);
                fileName = $"Change_Management_Review_Summary_{_result?.MonthYear}.xlsx";
            }
            
            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(fileContent));
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting Excel: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExportingExcel = false;
        }
    }

    private async Task ExportImage()
    {
        if (_result == null) return;
        
        try
        {
            _isExportingImage = true;
            string containerId = activeTabIndex == 0 ? "monthly-summary-export-wrapper" : (activeTabIndex == 1 ? "cm-review-export-wrapper" : "filtered-table-only");
            string fileName = activeTabIndex == 0 ? $"Change_Management_Summary_{_result.MonthYear}.png" : (activeTabIndex == 1 ? $"Change_Management_Review_Summary_{_result.MonthYear}.png" : $"Filtered_Excel_{_result.MonthYear}.png");
            
            await JSRuntime.InvokeVoidAsync("exportDivToImage", containerId, fileName);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting image: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExportingImage = false;
        }
    }

    private async Task CopyImage()
    {
        if (_result == null) return;
        
        try
        {
            _isCopyingImage = true;
            string containerId = activeTabIndex == 0 ? "monthly-summary-export-wrapper" : (activeTabIndex == 1 ? "cm-review-export-wrapper" : "filtered-table-only");
            var result = await JSRuntime.InvokeAsync<bool>("copyDivToClipboardImage", containerId);
            
            if (result)
                Snackbar.Add("Image copied to clipboard!", Severity.Success);
            else
                Snackbar.Add("Failed to copy image.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error copying image: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCopyingImage = false;
        }
    }

    private async Task ExportFilteredExcel()
    {
        // For Filtered Excel, we create a basic ClosedXML workbook on the fly and download it.
        // It's cleaner to handle it here or in the service. We can build a simple one here.
        if (_result == null || !_result.FilteredWorkOrders.Any()) return;
        
        try
        {
            _isExportingExcel = true;
            using var workbook = new ClosedXML.Excel.XLWorkbook();
            var ws = workbook.Worksheets.Add("Filtered Excel");
            
            // Headers
            ws.Cell(1, 1).Value = "WO";
            ws.Cell(1, 2).Value = "Stat";
            ws.Cell(1, 3).Value = "Subject";
            ws.Cell(1, 4).Value = "WO Type";
            ws.Cell(1, 5).Value = "Change Type";
            ws.Cell(1, 6).Value = "Service Name";
            ws.Cell(1, 7).Value = "Domain";
            ws.Cell(1, 8).Value = "NE Type";
            ws.Cell(1, 9).Value = "NE Count";
            ws.Cell(1, 10).Value = "Vendors";
            ws.Cell(1, 11).Value = "Issuer";
            ws.Cell(1, 12).Value = "QA / KPI Checked By";
            ws.Cell(1, 13).Value = "Assignee";
            ws.Cell(1, 14).Value = "SLA";
            ws.Cell(1, 15).Value = "Issue Date/Time";
            ws.Cell(1, 16).Value = "Proposed";
            ws.Cell(1, 17).Value = "Execution Start";
            ws.Cell(1, 18).Value = "Execution End";
            
            var headerRange = ws.Range(1, 1, 1, 18);
            headerRange.Style.Font.Bold = true;
            headerRange.Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.LightGray;
            
            // Data
            int row = 2;
            foreach (var wo in _result.FilteredWorkOrders)
            {
                ws.Cell(row, 1).Value = wo.WoId;
                ws.Cell(row, 2).Value = wo.Status;
                ws.Cell(row, 3).Value = wo.Subject;
                ws.Cell(row, 4).Value = wo.WoType;
                ws.Cell(row, 5).Value = wo.ChangeType;
                ws.Cell(row, 6).Value = wo.ServiceName;
                ws.Cell(row, 7).Value = wo.Domain;
                ws.Cell(row, 8).Value = wo.NeType;
                ws.Cell(row, 9).Value = wo.NeCount?.ToString();
                ws.Cell(row, 10).Value = wo.Vendor;
                ws.Cell(row, 11).Value = wo.Issuer;
                ws.Cell(row, 12).Value = wo.QaKpiCheckedBy;
                ws.Cell(row, 13).Value = wo.Assignee;
                ws.Cell(row, 14).Value = wo.Sla;
                ws.Cell(row, 15).Value = wo.IssueDateTime;
                ws.Cell(row, 16).Value = wo.ProposedDateTime;
                ws.Cell(row, 17).Value = wo.ExecutionStart;
                ws.Cell(row, 18).Value = wo.ExecutionEnd;
                row++;
            }
            
            ws.Columns().AdjustToContents();
            
            using var stream = new System.IO.MemoryStream();
            workbook.SaveAs(stream);
            var fileContent = stream.ToArray();
            
            var fileName = $"Filtered_Excel_{_result.MonthYear}.xlsx";
            using var streamRef = new Microsoft.JSInterop.DotNetStreamReference(stream: new System.IO.MemoryStream(fileContent));
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting Filtered Excel: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExportingExcel = false;
        }
    }

    private async Task ExportFilteredImage()
    {
        if (_result == null) return;
        try
        {
            _isExportingImage = true;
            string fileName = $"Filtered_Excel_{_result.MonthYear}.png";
            await JSRuntime.InvokeVoidAsync("exportDivToImage", "filtered-table-only", fileName);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting image: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExportingImage = false;
        }
    }

    private async Task CopyFilteredImage()
    {
        if (_result == null) return;
        try
        {
            _isCopyingImage = true;
            var result = await JSRuntime.InvokeAsync<bool>("copyDivToClipboardImage", "filtered-table-only");
            if (result)
                Snackbar.Add("Image copied to clipboard!", Severity.Success);
            else
                Snackbar.Add("Failed to copy image.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error copying image: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCopyingImage = false;
        }
    }

    private async Task DeleteUpload()
    {
        if (_selectedUpload == null) return;

        var parameters = new DialogParameters
        {
            { "ContentText", $"Are you sure you want to delete the dataset from '{_selectedUpload.UploadDate.ToString("MMM yyyy")}'? This cannot be undone." },
            { "SubmitText", "Delete Dataset" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<WO_CM_Review_Automation.Web.Components.Shared.Enterprise.EnterpriseDialog>("Delete Confirmation", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                _isLoading = true;
                
                var workOrders = await DbContext.WorkOrders.Where(w => w.UploadHistoryId == _selectedUpload.Id).ToListAsync();
                DbContext.WorkOrders.RemoveRange(workOrders);
                
                var historyToDelete = await DbContext.UploadHistories.FindAsync(_selectedUpload.Id);
                if (historyToDelete != null)
                {
                    DbContext.UploadHistories.Remove(historyToDelete);
                }
                
                await DbContext.SaveChangesAsync();
                
                Snackbar.Add("Dataset deleted successfully.", Severity.Success);
                
                _selectedUpload = null;
                _result = null;
                
                await OnInitializedAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting dataset: {ex.Message}", Severity.Error);
            }
            finally
            {
                _isLoading = false;
            }
        }
    }
}
