@inherits MudComponentBase
<EnterpriseCard Class="ent-p-md d-flex flex-column justify-center ent-card-hoverable position-relative" Style="height: 120px; overflow: hidden;">
    <div class="position-absolute" style="top: 0; left: 0; width: 4px; height: 100%; background-color: var(--color-accent-teal);"></div>
    <div class="d-flex justify-space-between align-start mb-2">
        <MudText Typo="Typo.overline" Style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.5px;">@Title</MudText>
        @if (!string.IsNullOrEmpty(Icon))
        {
            <MudIcon Icon="@Icon" Size="Size.Small" Style="color: var(--color-text-muted);" />
        }
    </div>
    <MudTooltip Text="@Value" Placement="Placement.Bottom">
        <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color: var(--color-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; line-height: 1.2; letter-spacing: -0.5px;">@Value</MudText>
    </MudTooltip>
    <MudText Typo="Typo.caption" Style="color: var(--color-text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; margin-top: 4px;">@SubText</MudText>
</EnterpriseCard>
@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string SubText { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public Color AccentColor { get; set; } = Color.Primary;
}
