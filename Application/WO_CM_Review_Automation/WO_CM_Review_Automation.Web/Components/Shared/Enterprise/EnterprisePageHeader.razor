@inherits MudComponentBase
<div class="d-flex flex-column flex-md-row justify-space-between align-md-end ent-page-header print-hide">
    <div>
        <MudText Typo="Typo.h3" Class="ent-text-h1 mb-1">@Title</MudText>
        <MudText Typo="Typo.body2" Class="ent-text-subtitle">@Subtitle</MudText>
    </div>
    <div class="d-flex flex-column flex-md-row ent-gap-md mt-4 mt-md-0 align-md-center">
        @ActionContent
    </div>
</div>
@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ActionContent { get; set; }
}
