<MudNavMenu Class="ent-nav-item mt-2">
    <div class="ent-nav-section-title">Workspace</div>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.GridView" Class="mb-3">Dashboard</MudNavLink>

    <div class="ent-nav-section-title">Data</div>
    <MudNavLink Href="/wo-list" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.TableChart" Class="mb-3">Work Order Archive</MudNavLink>

    <div class="ent-nav-section-title">Work Order Studio</div>
    <MudNavLink Href="/reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Description" Class="mb-3">WO Count</MudNavLink>

    <div class="ent-nav-section-title">CM Review studio</div>
    <MudNavLink Href="/cm-reviews" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Article" Class="mb-3 ent-nav-with-badge">
        <div class="d-flex justify-space-between align-center w-100">
            <span>CM Review Document</span>
            @if (PendingDocumentsCount > 0)
            {
                <span class="ent-nav-badge">@PendingDocumentsCount</span>
            }
        </div>
    </MudNavLink>

    <div class="ent-nav-section-title">System</div>
    <MudNavLink Href="/mappings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Tune" Class="mb-1">Mapping</MudNavLink>
    <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Settings">Settings</MudNavLink>
</MudNavMenu>

@code {
    [Parameter]
    public int PendingDocumentsCount { get; set; } = 3;
}
