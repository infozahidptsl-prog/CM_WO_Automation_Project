@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@implements IDisposable

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_enterpriseTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<div class="@(_isDarkMode ? "dark-mode" : "")">
    <MudLayout>
        
        <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Never" Variant="@DrawerVariant.Responsive" OpenMiniOnHover="true" MiniWidth="72px" Width="280px" Class="ent-drawer print-hide">
            <MudDrawerHeader Class="d-flex align-center px-4 py-4" Style="height: 64px; border-bottom: 1px solid var(--color-border-subtle);">
                <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Large" Color="Color.Primary" Class="mr-3" />
                <div class="d-flex flex-column" style="overflow: hidden; white-space: nowrap;">
                    <MudText Typo="Typo.body1" Class="font-weight-bold" Style="line-height: 1.2; color: var(--color-text-primary);">WO CM Review</MudText>
                    <MudText Typo="Typo.caption" Style="line-height: 1; color: var(--color-text-secondary); letter-spacing: 0.5px;">AUTOMATION</MudText>
                </div>
            </MudDrawerHeader>

            <NavMenu />
            
            <div class="mt-auto px-4 pb-4 pt-4" style="background: linear-gradient(to top, var(--color-bg-sidebar) 80%, transparent);">
                <MudButton Href="/about" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Info" FullWidth="true" Style="justify-content: flex-start; color: var(--color-text-muted);" Class="mb-2">About (v1.0.0)</MudButton>
            </div>
        </MudDrawer>

        <MudAppBar Elevation="0" Class="ent-appbar print-hide" ClipMode="DrawerClipMode.Never">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" Class="mr-2" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
            
            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--color-text-primary);">
                @GetPageContext()
            </MudText>
            
            <MudSpacer />
            
            <div class="d-flex align-center ent-gap-md">
                <MudText Typo="Typo.body2" Class="font-weight-medium d-none d-md-flex" Style="color: var(--color-text-secondary);">@DateTime.Now.ToString("dd MMM yyyy HH:mm")</MudText>
                
                <MudDivider Vertical="true" FlexItem="true" Class="mx-2 d-none d-md-flex" />
                
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleDarkMode" />
                
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="ml-2">
                    <ActivatorContent>
                        <MudButton Class="pa-0 text-none" Style="background: transparent;">
                            <div class="d-none d-md-flex flex-column text-right mr-3">
                                <MudText Typo="Typo.body2" Class="font-weight-bold" Style="color: var(--color-text-primary); line-height: 1.2;">Current User</MudText>
                                <MudText Typo="Typo.caption" Style="color: var(--color-text-muted); line-height: 1;">Administrator</MudText>
                            </div>
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" Class="font-weight-bold" Style="border: 2px solid var(--color-border-subtle);">CU</MudAvatar>
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="pa-4 d-md-none border-b-1" style="border-color: var(--color-border-subtle);">
                            <MudText Typo="Typo.body2" Class="font-weight-bold" Style="color: var(--color-text-primary);">Current User</MudText>
                            <MudText Typo="Typo.caption" Style="color: var(--color-text-muted);">Administrator</MudText>
                        </div>
                        <MudMenuItem Href="/logout" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">
                            <MudText Color="Color.Error">Logout</MudText>
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </div>
        </MudAppBar>

        <MudMainContent Class="ent-main-content">
            <MudContainer MaxWidth="MaxWidth.False" Class="ent-p-lg">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetPageContext()
    {
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        
        if (string.IsNullOrWhiteSpace(uri) || uri == "/") return "Dashboard";
        
        if (uri.StartsWith("upload", StringComparison.OrdinalIgnoreCase)) return "Upload Excel";
        if (uri.StartsWith("wo-list", StringComparison.OrdinalIgnoreCase)) return "WO Master List";
        if (uri.StartsWith("reports", StringComparison.OrdinalIgnoreCase)) return "Monthly Reports";
        if (uri.StartsWith("cm-reviews", StringComparison.OrdinalIgnoreCase)) return "Document List";
        if (uri.StartsWith("cm-review/document-preparation", StringComparison.OrdinalIgnoreCase)) return "Document Preparation";
        if (uri.StartsWith("mappings", StringComparison.OrdinalIgnoreCase)) return "Mapping Configuration";
        if (uri.StartsWith("history", StringComparison.OrdinalIgnoreCase)) return "Upload History";
        if (uri.StartsWith("settings", StringComparison.OrdinalIgnoreCase)) return "Settings";
        if (uri.StartsWith("report/", StringComparison.OrdinalIgnoreCase)) return "Report Details";
        
        return "Application";
    }

    private void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
    }

    private MudTheme _enterpriseTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#2563eb", /* var(--color-accent-blue) */
            Secondary = "#475569", /* var(--color-text-secondary) */
            Info = "#0ea5e9",
            Success = "#10b981",
            Warning = "#f59e0b",
            Error = "#ef4444",
            Background = "#f4f7f9", /* var(--color-bg-app) */
            Surface = "#ffffff", /* var(--color-bg-surface) */
            DrawerBackground = "#ffffff",
            AppbarBackground = "#ffffff",
            AppbarText = "#1e293b",
            LinesDefault = "#cbd5e1", /* var(--color-border-standard) */
            TextPrimary = "#1e293b", /* var(--color-text-primary) */
            TextSecondary = "#475569",
            TextDisabled = "#94a3b8"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#3b82f6",
            Secondary = "#cbd5e1",
            Info = "#38bdf8",
            Success = "#34d399",
            Warning = "#fbbf24",
            Error = "#fb7185",
            Background = "#0B1120", /* var(--color-bg-app) */
            Surface = "#1e293b", /* var(--color-bg-surface) */
            DrawerBackground = "#0f172a", /* var(--color-bg-sidebar) */
            AppbarBackground = "#0f172a", /* var(--color-bg-sidebar) */
            AppbarText = "#f8fafc",
            LinesDefault = "#334155", /* var(--color-border-standard) */
            TextPrimary = "#f8fafc", /* var(--color-text-primary) */
            TextSecondary = "#cbd5e1",
            TextDisabled = "#475569"
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "8px",
            AppbarHeight = "64px"
        }
    };
}
